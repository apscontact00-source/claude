# Copie ce fichier en .env et remplis-le. Aucune de ces variables n'est un token IA.

# (Optionnel) écriture Notion directe par le script, en cron 100% sans IA.
# Laisse vide pour n'écrire que les fichiers out/ et pousser dans Notion via /prime (MCP).
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=37a2c750-db1e-80ef-b0fd-e5a5b995f896

# (Optionnel) domaine Vinted si tu scannes un autre pays (ex: https://www.vinted.it)
VINTED_BASE=https://www.vinted.fr
